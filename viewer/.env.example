# Public dataset targets; both must already exist, be ungated and licensed.
HF_BENCHMARK_REPO=
HF_RUNS_REPO=
# Export HF_TOKEN only for publishing (write access to both repos).
# NEVER use VITE_HF_TOKEN. Pages only uses public, pinned URLs.

# Actions derives the base for c2a-bench/Context2Agent-Benchmark automatically.
VITE_BASE_PATH=/
# Dev defaults to original local jobs. Production uses the two-ref datasets/production.json.
VITE_DATA_MODE=
# VITE_DATA_RELEASE is generated/validated by npm run build:pages; don't set tokens in it.

# Optional original local-job lookup; not needed for migration or Pages:
# JOBS_DIR=
# REPO_ROOT=
