# Copy to .env and fill in. scripts/run_with_judge.sh passes it to Harbor (--env-file) and to the judge.
# Never commit .env.

# ---- Provider keys: the ones your models need (LiteLLM prefixes) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- The support agent and the simulated customer ----
# BOT_MODEL: the model the agent the builder makes uses for every call (the same for every builder, so builders compare).
BOT_MODEL=openai/gpt-5.6-sol
# EMBED_MODEL: the only embedding model the agent may use (also set in the builder's container).
EMBED_MODEL=openai/text-embedding-3-small
# CUSTOMER_MODEL: plays the customer. Empty = BOT_MODEL.
CUSTOMER_MODEL=

# ---- Grading ----
# Tickets graded at the same time.
VERIFIER_WORKERS=25
# Where tickets are graded: local (threads in the grader's container, no account needed) or daytona (one cloud
# sandbox per ticket, needs DAYTONA_API_KEY).
TICKET_SANDBOX=local
DAYTONA_API_KEY=
TICKET_SANDBOX_CPU=4
TICKET_SANDBOX_MEMORY_GIB=4
TICKET_SANDBOX_SNAPSHOT=

# ---- The fact judge (runs after a run; see README) ----
# JUDGE_MODEL reads the agent's files; FACTS_MODEL reads the conversations. Both default to openai/gpt-6.1-sol.
JUDGE_MODEL=openai/gpt-6.1-sol
FACTS_MODEL=openai/gpt-6.1-sol
# JUDGE_MODE: paste (default; the agent's files go into the prompt) or folder (Codex CLI / Claude Code in Docker
# opens them itself). Leave it unset here: scripts/run_arch.sh sets folder for Skyway, and a value in .env would
# override that when the judge loads .env.
# JUDGE_MODE=
# Judges at the same time on this machine (a folder judge is a Docker container).
JUDGE_SLOTS=2
